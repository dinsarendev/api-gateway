# ──────────────────────────────────────────────
# Vite dev-server proxy target (local dev only)
# ──────────────────────────────────────────────
API_URL=http://localhost:25010

# ──────────────────────────────────────────────
# Client-side environment label (VITE_ prefix = exposed in browser bundle)
# ──────────────────────────────────────────────
VITE_APP_ENV=development

# ──────────────────────────────────────────────
# Docker / nginx runtime variable (NOT a build-time var)
# Set this when running the container:
#   docker run -e BACKEND_URL=https://gateway-api.prod.cambofreelance.com ...
# ──────────────────────────────────────────────
# BACKEND_URL=https://gateway-api.prod.cambofreelance.com
